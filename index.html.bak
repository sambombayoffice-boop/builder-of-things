<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale.0" />
<title>BUILDER OF THINGS</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:auto}
body{overflow-x:hidden;background:#f5f3ef;color:#1a1917;font-family:'Space Grotesk',system-ui,sans-serif;font-weight:400;line-height:1.6;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
ul{list-style:none}
button{font:inherit;border:0;background:none;cursor:pointer}

/* CUSTOM CURSOR */
.cursor-dot{position:fixed;width:10px;height:10px;background:#1a1917;border-radius:50%;pointer-events:none;z-index:10000;transform:translate(-50%,-50%);transition:width .2s,height .2s,background .2s}
.cursor-ring{position:fixed;width:44px;height:44px;border:1.5px solid rgba(26,25,23,.25);border-radius:50%;pointer-events:none;z-index:10000;transform:translate(-50%,-50%);transition:width .35s,height .35s,border-color .35s}
.cursor-dot.hovering{width:50px;height:50px;background:rgba(26,25,23,.12)}
.cursor-ring.hovering{width:72px;height:72px;border-color:rgba(26,25,23,.12)}

/* LOADER */
.loader{position:fixed;inset:0;background:#f5f3ef;z-index:9999;display:flex;flex-direction:column;align-items:center;justify-content:center;transition:opacity .7s ease,visibility .7s}
.loader.hidden{opacity:0;visibility:hidden;pointer-events:none}
.loader-text{font-size:36px;font-weight:700;letter-spacing:-.04em;color:#1a1917}
.loader-text span{color:#ff4455}
.loader-bar{width:180px;height:2px;background:#ddd;margin-top:28px;border-radius:2px;overflow:hidden}
.loader-bar-fill{height:100%;width:0;background:#1a1917;border-radius:2px;transition:width .1s}
.loader-sub{font-family:'Space Mono',monospace;font-size:9px;letter-spacing:.15em;text-transform:uppercase;color:#8a8780;margin-top:18px}

/* CANVAS BG */
#bg-canvas{position:fixed;inset:0;z-index:0;pointer-events:none}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:100;padding:28px 48px;display:flex;justify-content:space-between;align-items:center;transition:all .4s ease}
nav.scrolled{background:rgba(245,243,239,.92);backdrop-filter:blur(16px);padding:18px 48px;box-shadow:0 1px 0 rgba(0,0,0,.06)}
.nav-logo{font-weight:700;letter-spacing:-.02em;font-size:14px}
.nav-logo span{color:#ff4455}
.nav-links{display:flex;gap:36px;align-items:center}
.nav-links a{font-family:'Space Mono',monospace;font-size:9px;letter-spacing:.15em;text-transform:uppercase;color:#8a8780;transition:color .3s}
.nav-links a:hover{color:#1a1917}
.nav-cta{padding:10px 22px;background:#1a1917;color:#f5f3ef;font-family:'Space Mono',monospace;font-size:9px;letter-spacing:.12em;text-transform:uppercase;border-radius:999px;transition:all .3s}
.nav-cta:hover{background:#ff4455}

/* HERO */
.hero{min-height:100vh;display:flex;align-items:center;position:relative;z-index:2;padding:140px 60px 100px}
.hero-content{max-width:1400px;margin:0 auto;width:100%;display:grid;grid-template-columns:1.1fr .9fr;gap:100px;align-items:center}
.hero-text{text-align:left}
.hero-tag{display:inline-flex;align-items:center;gap:10px;background:rgba(255,68,85,.07);border:1px solid rgba(255,68,85,.15);padding:8px 18px;border-radius:999px;margin-bottom:48px}
.hero-tag .dot{width:6px;height:6px;border-radius:50%;background:#ff4455}
.hero-tag span{font-family:'Space Mono',monospace;font-size:9px;letter-spacing:.15em;text-transform:uppercase;color:#ff4455}
.hero h1{font-size:clamp(42px,6.5vw,96px);line-height: 0.95;letter-spacing:-.045em;font-weight:700;color:#1a1917}
.hero h1 .accent{color:#ff4455}
.hero h1 .thin{font-weight:400;color:#6b6962}
.hero-h1-line{overflow:hidden;display:block}
.hero-h1-line span{display:inline-block;transform:translateY(115%);transition:transform 1.1s cubic-bezier(.22,1,.3,1)}
.hero-h1-line.anim span{transform:translateY(0)}
.hero-sub{max-width:480px;color:#6b6962;font-size:16px;margin-top:36px;line-height:1.8;letter-spacing:-.01em}
.hero-actions{display:flex;gap:16px;margin-top:52px;flex-wrap:wrap}
.btn-magnetic{position:relative;display:inline-flex;align-items:center;gap:12px;padding:20px 36px;font-size:12px;letter-spacing:.1em;text-transform:uppercase;border-radius:999px;transition:transform .3s cubic-bezier(.22,1,.3,1)}
.btn-magnetic .btn-inner{position:relative;z-index:1}
.btn-primary{background:#1a1917;color:#f5f3ef;transition:all .35s cubic-bezier(.22,1,.3,1)}
.btn-primary:hover{background:#ff4455;transform:translateY(-2px);box-shadow:0 12px 40px rgba(255,68,85,.2)}
.btn-ghost{border:1.5px solid #d4d0c8;color:#1a1917;background:transparent}
.btn-ghost:hover{border-color:#1a1917}
.hero-phone{position:relative;display:flex;justify-content:center}
.phone-mockup{width:280px;height:560px;background:#fff;border-radius:44px;border:1px solid #e0ddd6;padding:10px;position:relative;transform:perspective(800px) rotateY(-6deg) rotateX(3deg);transition:transform .7s cubic-bezier(.22,1,.3,1);box-shadow:0 30px 80px rgba(0,0,0,.08),0 0 0 1px rgba(0,0,0,.02) inset}
.phone-mockup:hover{transform:perspective(800px) rotateY(0) rotateX(0)}
.phone-notch{width:100px;height:22px;background:#1a1917;border-radius:0 0 14px 14px;margin:0 auto;position:relative;z-index:2}
.phone-screen{width:100%;height:calc(100% - 22px);background:#faf9f6;border-radius:34px;overflow:hidden;position:relative}
.screen-header{padding:14px 16px;text-align:center;border-bottom:1px solid #eee}
.screen-header span{font-family:'Space Mono',monospace;font-size:7px;letter-spacing:.15em;text-transform:uppercase;color:#ff4455}
.screen-chat{padding:10px 14px;display:flex;flex-direction:column;gap:8px}
.chat-msg{max-width:88%;padding:10px 14px;border-radius:16px;font-size:10px;line-height:1.5;animation:chat-in .6s cubic-bezier(.22,1,.3,1) both}
.chat-msg.user{text-align:right;background:#ff4455;color:#fff;align-self:flex-end;border-bottom-right-radius:4px}
.chat-msg.ai{text-align:left;background:#eae8e2;color:#1a1917;align-self:flex-start;border-bottom-left-radius:4px}
.chat-msg:nth-child(1){animation-delay:.5s}
.chat-msg:nth-child(2){animation-delay:.9s}
.chat-msg:nth-child(3){animation-delay:1.3s}
.chat-msg:nth-child(4){animation-delay:1.7s}
.chat-msg:nth-child(5){animation-delay:2.1s}
.screen-voice-bar{margin:10px;padding:10px 14px;background:rgba(255,68,85,.04);border:1px solid rgba(255,68,85,.1);border-radius:14px;display:flex;align-items:center;gap:10px}
.voice-wave{display:flex;gap:2px;align-items:center;height:20px}
.voice-bar{width:3px;border-radius:2px;background:#ff4455;animation:bar-wave .8s ease-in-out infinite alternate}
.voice-bar:nth-child(1){height:6px;animation-delay:0s}
.voice-bar:nth-child(2){height:14px;animation-delay:.1s}
.voice-bar:nth-child(3){height:8px;animation-delay:.2s}
.voice-bar:nth-child(4){height:18px;animation-delay:.15s}
.voice-bar:nth-child(5){height:5px;animation-delay:.05s}
.voice-bar:nth-child(6){height:12px;animation-delay:.25s}
.voice-bar:nth-child(7){height:10px;animation-delay:.1s}
.voice-text{font-family:'Space Mono',monospace;font-size:7px;color:#8a8780;text-transform:uppercase;letter-spacing:.1em}
@keyframes pulse-dot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(.7)}}
@keyframes chat-in{0%{opacity:0;transform:translateY(16px) scale(.96)}100%{opacity:1;transform:translateY(0) scale(1)}}
@keyframes bar-wave{0%{transform:scaleY(.4)}100%{transform:scaleY(1.3)}}

/* SECTION DIVIDER */
.section-divider{height:1px;background:#e0ddd8;margin:0 60px;z-index:2;position:relative}

/* SECTIONS */
.section{padding:140px 60px;position:relative;z-index:2}
.section-header{max-width:1400px;margin:0 auto 80px}
.eyebrow{font-family:'Space Mono',monospace;font-size:10px;letter-spacing:.15em;text-transform:uppercase;color:#ff4455;margin-bottom:20px;display:flex;align-items:center;gap:12px}
.eyebrow::before{content:'';width:20px;height:1px;background:#ff4455}
.section-title{font-size:clamp(34px,4.5vw,72px);font-weight:700;letter-spacing:-.035em;line-height:1.05;color:#1a1917;margin-bottom:24px}
.section-desc{max-width:520px;color:#6b6962;font-size:15px;line-height:1.7}
.container{max-width:1400px;margin:0 auto}

/* CARDS */
.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:16px}
.card{background:#fff;border:1px solid #e0ddd8;border-radius:24px;padding:40px;transition:all .5s cubic-bezier(.22,1,.3,1);position:relative;overflow:hidden}
.card::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at var(--mx,50%) var(--my,50%),rgba(255,68,85,.05),transparent 60%);opacity:0;transition:opacity .5s}
.card:hover::before{opacity:1}
.card:hover{border-color:rgba(255,68,85,.25);transform:translateY(-6px);box-shadow:0 24px 60px rgba(0,0,0,.06)}
.card-icon{width:48px;height:48px;border-radius:14px;display:flex;align-items:center;justify-content:center;margin-bottom:24px;font-size:20px;background:#f5f3ef;transition:transform .4s cubic-bezier(.22,1,.3,1)}
.card:hover .card-icon{transform:scale(1.1) rotate(-8deg)}
.card-num{font-family:'Space Mono',monospace;font-size:9px;color:#b4b0a8;margin-bottom:12px;letter-spacing:.1em}
.card h3{font-size:18px;font-weight:700;letter-spacing:-.01em;color:#1a1917;margin-bottom:8px}
.card-tag{font-size:12px;color:#ff4455;font-weight:500;margin-bottom:10px}
.card p{color:#6b6962;font-size:13px;line-height:1.6}
.card-link{display:inline-flex;align-items:center;gap:8px;margin-top:20px;font-family:'Space Mono',monospace;font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:#b4b0a8;transition:all .3s}
.card:hover .card-link{color:#ff4455;gap:14px}

/* LEVERS */
.levers{display:grid;grid-template-columns:repeat(4,1fr);gap:2px}
.lever{background:#fff;padding:48px 32px;min-height:320px;display:flex;flex-direction:column;justify-content:space-between;transition:all .4s}
.lever:hover{background:#faf9f6}
.lever-accent{width:36px;height:3px;background:#ff4455;margin-bottom:24px;transition:width .4s}
.lever:hover .lever-accent{width:60px}
.lever-num{font-family:'Space Mono',monospace;font-size:9px;color:#ff4455;margin-bottom:16px;letter-spacing:.15em}
.lever h3{font-size:18px;font-weight:700;color:#1a1917;margin-bottom:12px}
.lever p{color:#6b6962;font-size:13px;line-height:1.6}

/* BELIEFS */
.beliefs{max-width:900px}
.belief{padding:40px 0;border-bottom:1px solid #e0ddd8;display:flex;gap:24px;align-items:flex-start;transition:all .3s}
.belief:hover{padding-left:16px}
.belief-num{font-family:'Space Mono',monospace;font-size:11px;color:#ff4455;min-width:30px;font-weight:700}
.belief h3{font-size:clamp(18px,2vw,22px);font-weight:600;color:#1a1917;margin-bottom:8px}
.belief:hover h3{color:#ff4455}
.belief p{color:#6b6962;font-size:14px;line-height:1.7;max-width:600px}

/* MARQUEE */
.marquee-bar{padding:22px 0;background:#faf9f6;border-top:1px solid #e0ddd8;border-bottom:1px solid #e0ddd8;overflow:hidden;z-index:2;position:relative}
.marquee-track{display:flex;gap:48px;animation:marquee 25s linear infinite;width:max-content}
.marquee-item{font-size:14px;font-weight:600;text-transform:uppercase;letter-spacing:.15em;color:#b4b0a8;white-space:nowrap;display:flex;align-items:center;gap:48px}
.marquee-item .sep{width:4px;height:4px;border-radius:50%;background:#ff4455}
@keyframes marquee{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}

/* STACK */
.stack{padding:40px 60px;border-top:1px solid #e0ddd8;border-bottom:1px solid #e0ddd8;display:flex;align-items:center;gap:32px;flex-wrap:wrap;z-index:2;position:relative}
.stack-label{font-family:'Space Mono',monospace;font-size:9px;letter-spacing:.15em;text-transform:uppercase;color:#b4b0a8}
.stack-badges{display:flex;gap:10px;flex-wrap:wrap}
.stack-badge{padding:10px 18px;background:#fff;border:1px solid #e0ddd8;border-radius:999px;font-family:'Space Mono',monospace;font-size:9px;letter-spacing:.08em;text-transform:uppercase;color:#6b6962;transition:all .3s}
.stack-badge:hover{border-color:#ff4455;color:#ff4455}
.stack-badge strong{display:block;color:#1a1917;margin-bottom:2px}

/* CONTACT */
.contact{padding:180px 60px;text-align:center;position:relative;z-index:2;background:#1a1917;color:#f5f3ef;border-radius:32px;margin:0 60px 80px}
.contact h2{font-size:clamp(40px,8vw,140px);font-weight:700;letter-spacing:-.04em;line-height:.85;transition:color .3s}
.contact h2:hover{color:#ff4455}
.contact-sub{max-width:450px;color:#8a8780;font-size:15px;margin:32px auto 0;line-height:1.7}
.contact-btn{display:inline-flex;align-items:center;gap:12px;margin-top:48px;padding:20px 36px;background:#ff4455;color:#f5f3ef;font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;border-radius:999px;transition:all .3s cubic-bezier(.22,1,.3,1)}
.contact-btn:hover{background:#fff;color:#1a1917;transform:translateY(-2px);box-shadow:0 16px 48px rgba(255,68,85,.2)}
.contact-btn svg{transition:transform .3s}
.contact-btn:hover svg{transform:translate(4px,-4px)}

/* FOOTER */
footer{padding:32px 60px;border-top:1px solid #e0ddd8;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;z-index:2;position:relative}
footer .copy{font-family:'Space Mono',monospace;font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:#b4b0a8}
footer .copy strong{color:#ff4455}

/* REVEAL ANIMATION */
.reveal{opacity:0;transform:translateY(30px);transition:opacity .9s cubic-bezier(.22,1,.3,1),transform .9s cubic-bezier(.22,1,.3,1)}
.reveal.visible{opacity:1;transform:translateY(0)}
.reveal-delay-1{transition-delay:.1s}
.reveal-delay-2{transition-delay:.2s}
.reveal-delay-3{transition-delay:.3s}
.reveal-delay-4{transition-delay:.4s}

/* RESPONSIVE */
@media(max-width:1024px){
  .hero-content{grid-template-columns:1fr;gap:60px}
  .hero-phone{order:-1}
  .levers{grid-template-columns:repeat(2,1fr)}
  .section{padding:100px 30px}
  .hero{padding:100px 30px 60px}
  .contact{margin:0 20px 60px;padding:100px 30px}
}
@media(max-width:768px){
  nav{padding:16px 20px}
  .nav-links{display:none}
  .hero{padding:80px 20px 40px}
  .section{padding:80px 20px}
  .levers{grid-template-columns:1fr}
  .cards{grid-template-columns:1fr}
  .hero-phone{transform:scale(.85)}
  footer{padding:24px 20px}
  .stack{padding:24px 20px}
  .contact{padding:100px 20px;margin:0 12px 40px}
  .section-divider{margin:0 20px}
}
</style>
</head>
<body>

<!-- LOADER -->
<div class="loader" id="loader">
  <div class="loader-text">BUILDER OF <span>THINGS</span></div>
  <div class="loader-bar"><div class="loader-bar-fill" id="loader-fill"></div></div>
  <div class="loader-sub">Initializing experience...</div>
</div>

<!-- CUSTOM CURSOR -->
<div class="cursor-dot" id="cursor-dot"></div>
<div class="cursor-ring" id="cursor-ring"></div>

<!-- CANVAS BG – soft organic blobs, no noise -->
<canvas id="bg-canvas"></canvas>

<!-- NAV -->
<nav id="nav">
  <div class="nav-logo">BUILDER OF <span>THINGS</span></div>
  <div class="nav-links">
    <a href="#noah">NOAH</a>
    <a href="#studio">STUDIO</a>
    <a href="#levers">APPROACH</a>
    <a href="#beliefs">BELIEFS</a>
    <button class="nav-cta" onclick="document.getElementById('contact').scrollIntoView({behavior:'smooth',block:'start'})">GET IN TOUCH</button>
  </div>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="hero-content">
    <div class="hero-text">
      <div class="hero-tag">
        <span class="dot"></span>
        <span>Now Taking Partners — Q3 2026</span>
      </div>
      <h1>
        <span class="hero-h1-line"><span>We</span></span>
        <span class="hero-h1-line"><span>Build</span></span>
        <span class="hero-h1-line"><span class="accent">Things</span></span>
        <span class="hero-h1-line"><span>That</span></span>
        <span class="hero-h1-line"><span class="thin">Think, Speak,</span></span>
        <span class="hero-h1-line"><span class="thin">Evolve.</span></span>
      </h1>
      <p class="hero-sub">An AI-first studio and high-leverage advisory platform. Voice-first OSes. Cinematic tools. Autonomous agents. Positioning. Authority. Capital.</p>
      <div class="hero-actions">
        <a href="#noah" class="btn-magnetic btn-primary" data-magnetic>
          <span class="btn-inner">MEET NOAH</span>
        </a>
        <a href="#studio" class="btn-magnetic btn-ghost" data-magnetic>
          <span class="btn-inner">EXPLORE STUDIO</span>
        </a>
      </div>
    </div>
    <div class="hero-phone">
      <div class="phone-mockup" id="phone-mockup">
        <div class="phone-notch"></div>
        <div class="phone-screen">
          <div class="screen-header">
            <span>NOAH · AI ASSISTANT</span>
          </div>
          <div class="screen-chat">
            <div class="chat-msg user">Bhook lagi hai. Khana order karo.</div>
            <div class="chat-msg ai">Order ho gaya! Pizza Margherita — 24 min mein.</div>
            <div class="chat-msg user">Kal subah 10 baje appointment.</div>
            <div class="chat-msg ai">Done. Dr. Sharma, tomorrow 10 AM. Reminder bhejunga.</div>
            <div class="chat-msg user">GST file kar do isi month ka.</div>
          </div>
          <div class="screen-voice-bar">
            <div class="voice-wave">
              <span class="voice-bar"></span>
              <span class="voice-bar"></span>
              <span class="voice-bar"></span>
              <span class="voice-bar"></span>
              <span class="voice-bar"></span>
              <span class="voice-bar"></span>
              <span class="voice-bar"></span>
            </div>
            <span class="voice-text">Listening...</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- MARQUEE -->
<div class="marquee-bar">
  <div class="marquee-track">
    <div class="marquee-item">VOICE-FIRST <span class="sep"></span></div>
    <div class="marquee-item">CINEMATIC <span class="sep"></span></div>
    <div class="marquee-item">AUTONOMOUS <span class="sep"></span></div>
    <div class="marquee-item">MULTILINGUAL <span class="sep"></span></div>
    <div class="marquee-item">SOVEREIGN <span class="sep"></span></div>
    <div class="marquee-item">AI-FIRST <span class="sep"></span></div>
    <div class="marquee-item">VOICE-FIRST <span class="sep"></span></div>
    <div class="marquee-item">CINEMATIC <span class="sep"></span></div>
    <div class="marquee-item">AUTONOMOUS <span class="sep"></span></div>
    <div class="marquee-item">MULTILINGUAL <span class="sep"></span></div>
    <div class="marquee-item">SOVEREIGN <span class="sep"></span></div>
    <div class="marquee-item">AI-FIRST <span class="sep"></span></div>
  </div>
</div>

<!-- NOAH -->
<section class="section" id="noah">
  <div class="container">
    <div class="section-header reveal">
      <div>
        <div class="eyebrow">01 — Flagship</div>
        <h2 class="section-title">NOAH</h2>
        <p class="section-desc">For the 60 million Indians who speak but can't type. NOAH books appointments, files GST, drafts WhatsApp replies — in 17 languages. No typing. No apps. Just speak.</p>
      </div>
    </div>
    <div style="background:#fff;border:1px solid #e0ddd8;border-radius:24px;padding:60px;position:relative;overflow:hidden" class="reveal">
      <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:350px;height:350px;background:radial-gradient(circle,rgba(255,68,85,.06),transparent 70%);pointer-events:none;border-radius:50%"></div>
      <div style="text-align:center;position:relative;z-index:1">
        <div style="width:100px;height:100px;border-radius:50%;border:2px solid rgba(255,68,85,.15);display:flex;align-items:center;justify-content:center;margin:0 auto 24px">
          <div style="position:absolute;inset:-16px;border-radius:50%;border:1px solid rgba(255,68,85,.06);animation:pulse-border 3s ease-in-out infinite"></div>
          <div style="width:16px;height:16px;background:#ff4455;border-radius:50%;box-shadow:0 0 30px rgba(255,68,85,.3)"></div>
        </div>
        <div style="display:flex;gap:6px;justify-content:center;margin-bottom:20px">
          <span style="width:3px;border-radius:2px;background:#ff4455;animation:bar-wave .6s ease-in-out infinite alternate;height:6px"></span>
          <span style="width:3px;border-radius:2px;background:#ff4455;animation:bar-wave .5s ease-in-out infinite alternate 0.1s;height:14px"></span>
          <span style="width:3px;border-radius:2px;background:#1a1917;animation:bar-wave .7s ease-in-out infinite alternate 0.2s;height:10px"></span>
          <span style="width:3px;border-radius:2px;background:#ff4455;animation:bar-wave .4s ease-in-out infinite alternate 0.3s;height:20px"></span>
